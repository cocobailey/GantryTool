<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline checks for save compatibility. Runs on .NET Framework, outside the game.
       Build the mod first, then: dotnet run -c Release (project tests\GantryTool.Tests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ManagedDLLPath>D:\SteamLibrary\steamapps\common\Cities_Skylines\Cities_Data\Managed</ManagedDLLPath>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <!-- The Mac game's UnityEngine.dll won't load under plain Mono, so the tests use a copy of the Windows game's DLLs -->
    <ManagedDLLPath>$(MSBuildThisFileDirectory)../../reference/windows-managed</ManagedDLLPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The version FPS Booster's Patch Loader ships, for the checks on the mod DLL itself (DllChecks.cs) -->
    <PackageReference Include="Mono.Cecil" Version="0.10.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="GantryTool">
      <HintPath>..\..\bin\Release\GantryTool.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDLLPath)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDLLPath)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(ManagedDLLPath)\ColossalManaged.dll</HintPath>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(ManagedDLLPath)\ICities.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
